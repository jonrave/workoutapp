{
  "name": "peakspan",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @peakspan/web",
    "dev": "npm run dev -w @peakspan/web",
    "start": "npm run start -w @peakspan/web",
    "test": "vitest run",
    "typecheck": "tsc -p packages/engine/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
